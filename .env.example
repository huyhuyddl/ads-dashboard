# ── Flask ──────────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-change-this
DEBUG=true
PORT=5000
APP_BASE_URL=http://localhost:5000

# ── MySQL ──────────────────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DB=ads_dashboard
MYSQL_POOL_SIZE=10

# ── Facebook Ads ───────────────────────────────────────────────────────────
# Tạo tại: developers.facebook.com → My Apps → Create App → Business
FB_APP_ID=
FB_APP_SECRET=

# ── Google Ads ─────────────────────────────────────────────────────────────
# Tạo tại: console.cloud.google.com → APIs & Services → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── TikTok Ads ─────────────────────────────────────────────────────────────
# Tạo tại: business.tiktok.com/portal/apps → Marketing API
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# ── Business logic ─────────────────────────────────────────────────────────
# Tỷ giá USD → VND (cập nhật theo thực tế)
USD_TO_VND=23000
